# --- Telegram ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# --- LLM ---
# openai  — любой OpenAI-совместимый API: OpenRouter, Groq, Gemini, локальная Ollama/vLLM
# anthropic — Claude API
LLM_PROVIDER=openai

# OpenRouter (по умолчанию). Бесплатные модели с поддержкой инструментов:
# https://openrouter.ai/models?max_price=0&supported_parameters=tools
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Обязательно модель с поддержкой tools (function calling), например <vendor>/<model>:free
LLM_MODEL=

# Для LLM_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5

# Бюджет шагов (вызовов инструментов)
MAX_STEPS_PER_QUESTION=12
DAILY_STEPS_PER_USER=50
# Telegram id админов через запятую — для них дневной лимит не действует
ADMIN_IDS=

# --- Данные ---
# Биржи через ccxt (id из ccxt)
EXCHANGES=binance,bybit,okx,bitget,gate,mexc,kucoin,bingx,hyperliquid
# Необязательные ключи
COINGECKO_API_KEY=
# Веб-поиск (бесплатный тариф): https://tavily.com
TAVILY_API_KEY=
CRYPTOPANIC_API_KEY=

# --- X (Twitter): только новости и мнения инфлюенсеров ---
# Парсер twitterapi.io, оплата за объём: https://twitterapi.io
TWITTERAPI_IO_KEY=
# Аккаунты новостей и инфлюенсеров через запятую (без @).
# Пусто = список по умолчанию из swarm/config.py
X_ACCOUNTS=

# --- Правила сетапов (валидатор) ---
MIN_RR=1.3
MIN_STOP_PCT_MAJOR=1.5
MIN_STOP_PCT_ALT=3.0
MIN_STOP_ATR_MULT=1.5
MAJORS=BTC,ETH

# --- Прочее ---
TIMEZONE=Europe/Kyiv
DB_PATH=swarm.db
LOG_LEVEL=INFO
