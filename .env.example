# --- Telegram ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# --- LLM: основная модель ---
# PROVIDER: openai — любой OpenAI-совместимый API (Gemini, OpenRouter, Groq, Ollama)
#           anthropic — Claude API
#           claude_code — Claude Code на твоей подписке Claude, без API-ключа (сначала claude_setup.bat).
#                         LLM_MODEL можно оставить пустым или указать opus / sonnet.
#                         Запасная модель FALLBACK_LLM_* (API) включится, если Claude Code упрётся в лимит.
# По умолчанию: бесплатный Gemini Flash (ключ: https://aistudio.google.com/apikey)
LLM_PROVIDER=openai
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
# Последняя Flash-модель из списка в AI Studio, например gemini-<версия>-flash
LLM_MODEL=

# --- LLM: запасная модель ---
# Включается, если основная вернула ошибку или упёрлась в лимит.
# По умолчанию: бесплатная модель OpenRouter (ключ: https://openrouter.ai/settings/keys)
# Список бесплатных с инструментами: https://openrouter.ai/models?max_price=0&supported_parameters=tools
FALLBACK_LLM_PROVIDER=openai
FALLBACK_LLM_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=z-ai/glm-5.2:free
# Сколько секунд не возвращаться к основной после ошибки (при дневной квоте — минимум час)
LLM_COOLDOWN_SEC=600

# --- Картинки (графики, скрины позиций и новостей из каналов и X) ---
# По умолчанию — основная модель (Gemini Flash умеет картинки). Отдельная модель — VISION_LLM_*:
# VISION_LLM_PROVIDER=openai
# VISION_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# VISION_LLM_API_KEY=
# VISION_LLM_MODEL=
# Сколько картинок в день разбирать (бережёт бесплатный лимит)
VISION_DAILY_LIMIT=300

# Claude вместо любой из них:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=<ключ Anthropic>
# LLM_MODEL=claude-opus-5

# Бюджет шагов (вызовов инструментов)
MAX_STEPS_PER_QUESTION=12
DAILY_STEPS_PER_USER=50
# Telegram id админов через запятую — для них дневной лимит не действует
ADMIN_IDS=

# --- Данные ---
# Биржи через ccxt (id из ccxt)
EXCHANGES=binance,bybit,okx,bitget,gate,mexc,kucoin,bingx,hyperliquid,aster
# Необязательные ключи
COINGECKO_API_KEY=

# --- Поиск в интернете ---
# Работает без ключей (DuckDuckGo). Ключи ниже — по желанию, дают более стабильный поиск:
# Tavily (бесплатный тариф): https://tavily.com
TAVILY_API_KEY=
# Brave Search API (бесплатный тариф): https://brave.com/search/api/
BRAVE_API_KEY=
# Чтение страниц: jina (чистый текст, работает без ключа) или direct (напрямую)
WEB_READER=jina
JINA_API_KEY=
CRYPTOPANIC_API_KEY=

# --- X (Twitter): только новости и мнения инфлюенсеров ---
# Парсер twitterapi.io, оплата за объём: https://twitterapi.io
TWITTERAPI_IO_KEY=
# Аккаунты новостей и инфлюенсеров через запятую (без @).
# Пусто = список по умолчанию из bottom/config.py
X_ACCOUNTS=

# --- Telegram-источники (каналы и чаты, читаются через ТВОЙ аккаунт) ---
# api_id и api_hash: https://my.telegram.org → API development tools
# (можно не заполнять — скрипт спросит сам и сохранит сюда)
TG_API_ID=
TG_API_HASH=
# Файл сессии (создаётся при первом входе). НЕ публикуй его — это доступ к аккаунту.
TG_SESSION=data/telegram
# Реестр источников: публичные и приватные каналы, чаты, чаты с темами
TG_SOURCES_FILE=channels/sources.json
# Как часто догружать пропущенное (новые сообщения приходят вживую сразу)
TG_RESYNC_MINUTES=60
# Сколько дней истории прочитать при первом запуске (0 = весь канал целиком — долго)
TG_BACKFILL_DAYS=30
# Сколько дней хранить сообщения (0 = всегда)
TG_KEEP_DAYS=180
# true — бот может называть приватные источники и давать на них ссылки в ответах
TG_SHOW_PRIVATE=false

# --- Правила сетапов (валидатор) ---
MIN_RR=1.3
MIN_STOP_PCT_MAJOR=1.5
MIN_STOP_PCT_ALT=3.0
MIN_STOP_ATR_MULT=1.5
MAJORS=BTC,ETH

# --- Обучение на ошибках ---
# Час (UTC), когда бот раз в сутки разбирает свои сетапы и жалобы /wrong и пишет уроки
LEARN_HOUR_UTC=3

# --- Прочее ---
TIMEZONE=Europe/Kyiv
DB_PATH=bottom.db
LOG_LEVEL=INFO

# --- Парсеры ---
# Telegram-группа (форум), куда пишут парсеры (OI, Funding, Dep / With, Whale perp, Спреды). Bottom читает её
# через твой аккаунт Telegram (TG_API_ID/TG_API_HASH). id вида -100...; несколько — через запятую.
# Его записывает setup_group.bat парсеров (C:\parser\.env: SIGNALS_CHAT_ID).
PARSER_CHAT_ID=

# --- Claude Code ---
# Путь к claude, если он не в PATH
# CLAUDE_BIN=
